# ============================================
# MoAI-ADK Package Distribution .gitignore
# ============================================
# Version: 0.33.0
# Purpose: Essential patterns for user projects
# ============================================

# ===========================================
# Go Build Artifacts
# ===========================================
bin/
*.exe
*.exe~
*.dll
*.so
*.dylib
cover.out
cover.html
cpu.prof
mem.prof

# ===========================================
# Build Artifacts & Distribution
# ===========================================
build/
dist/
*.egg-info/
*.egg

# ===========================================
# Python Cache & Bytecode
# ===========================================
__pycache__/
.pytest_cache/
*.pyc
*.pyo
*.pyd
.mypy_cache/
.ruff_cache/
*.db
*.sqlite
*.sqlite3
*.rdb
*.dbm

# ===========================================
# Virtual Environments
# ===========================================
venv/
.venv/
env/
.env/
.uv_cache/
.uv-cache/

# ===========================================
# Test Coverage
# ===========================================
.coverage
coverage.json
htmlcov/

# ===========================================
# IDE & Editors
# ===========================================
.vscode/
.idea/
*.swp
*.swo
*.sw?
*~
.cursor/
*.sublime-project
*.sublime-workspace
*.njsproj
*.sln
*.suo
.#*

# ===========================================
# OS Files
# ===========================================
# Mac
.DS_Store
.AppleDouble
.LSOverride
.DocumentRevisions-V100
.fseventsd
.Spotlight-V100
.TemporaryItems
.Trashes
.VolumeIcon.icns

# Windows
[Dd]esktop.ini
Thumbs.db
ehthumbs.db

# Linux
.directory

# ===========================================
# Logs & Temporary Files
# ===========================================
*.log
logs/*
!logs/.gitkeep
*.tmp
*.temp
*.bak
*.backup

# ===========================================
# Backups
# ===========================================
.moai-backups/
.moai/backups/
*.backup/
*-backup/
*_backup_*/

# ===========================================
# Secrets and Credentials (CRITICAL)
# ===========================================
# Environment files
.env
.env.*
!.env.example

# Certificate files
*.pem
*.p12
*.pfx
*.jks

# Private keys (specific patterns to avoid false positives)
# FIXED: Issue #237 - Replaced overly broad *key* and *secret* patterns
*-key.*
*_key.*
*.key.*
*-secret-key.*
*-api-key.*
api-key-*
secret-key-*
private-key*
*-secret.*
*_secret.*
*.secret.*
secret-*.*

# Credential patterns in environment files
*_secret=*
*_token=*

# Cloud provider credentials
.aws/config
.aws/credentials

# MoAI git-credential runtime files (defense-in-depth). The reconfigure wizard
# delegates git provider credentials to the gh/glab CLI and never writes an
# access token to a tracked config; these patterns ensure that if a
# credential-bearing runtime file is ever introduced under .moai/, it is not
# committed.
.moai/**/credentials.yaml
.moai/**/*.credentials

# MINK agent credentials (plaintext API keys, per AC-CR-026).
# Ignored anywhere in the tree so per-project auth dirs are never committed.
**/.mink/auth/

# ===========================================
# Claude Code Configuration
# ===========================================
.claude/settings.local.json
.claude/settings.local.*.json
.claude/.env.local*
.claude/local/
.claude/plans/
.claude/agent-memory/
.claude/worktrees/

# Skill-specific credentials
.claude/skills/*/.env*
.claude/skills/*/secrets/
.claude/skills/*/*/*secret*
.claude/skills/*/*/*key*
.claude/skills/*/*/*token*
# Re-include legitimate skill module files containing "token" in their name
!.claude/skills/*/modules/*token*.md

# ===========================================
# Local-Only Files (never sync via git pull)
# ===========================================
.moai/status_line.sh
.moai/memory/
.moai/worktrees/
.moai/branches/

# ===========================================
# Update Noise-Suppression Ledgers (per-machine, never tracked)
# Per-machine cache ledgers used to suppress redundant update noise.
# 주의: .moai/state/ 는 여기서 통째로 무시하지 않는다. 아래 "MoAI 런타임 상태" 구간이
# 파일 단위(**/.moai/state/*)로 제외하고 session-memo.md 만 예외로 추적한다.
# 템플릿의 `.moai/state/` 한 줄은 그 ! 예외를 무효화하므로 의도적으로 뺐다.
# ===========================================
.moai/cache/

# 세션별 자동 생성 리포트는 휘발성 로그이므로 추적하지 않는다.
# plan-audit/, sync-report-*, 연구 리포트 등 산출물 문서는 계속 추적한다.
# (템플릿의 .moai/reports/plan-audit/*.md 무시 규칙은 프로젝트 방침과 달라 채택하지 않았다.)
.moai/reports/session-*.md

# ===========================================
# Evolution Telemetry (local-only usage data)
# Learnings and new-skills are git-tracked for team sharing.
# ===========================================
.moai/evolution/telemetry/*.jsonl
!.moai/evolution/telemetry/.gitkeep

# ===========================================
# Node.js (for docs/Nextra)
# ===========================================
node_modules/
*.tsbuildinfo
.tscache/
.next/
out/

# ===========================================
# Build Tools & Frameworks
# ===========================================
.turbo/
.nuxt/
dist-ssr/

# ===========================================
# Deployment & CI/CD
# ===========================================
.vercel/
.netlify/
.firebase/

# User Custom Patterns (preserved by moai update)
/target/
src-tauri/target/
src-tauri/WixTools/
src-tauri/gen/
playwright-report/
test-results/

# MoAI 런타임 상태 (세션마다 생성/변경 — 공유 대상 아님)
# state/ 는 통째로 무시하고 공유가 필요한 파일만 되살린다. 세션 중에도 새 런타임
# 파일이 생기므로(harness/, lessons-inbox.jsonl 등) 개별 나열보다 안전하다.
# 주의: 앞으로 .moai/state/ 에 공유해야 할 파일이 생기면 아래에 ! 로 명시해야 한다.
# `.moai/state/*` 는 슬래시를 포함하므로 저장소 루트만 막았다. 도구가 실행 위치에 따라
# <아무폴더>/.moai/state/ 를 만들면 그대로 통과해, 실제로 SPEC 폴더 안의
# context-usage.json 이 두 번 커밋됐다(SPEC-AI-009, SPEC-AI-011). 위치와 무관하게 막는다.
# 디렉터리(`**/.moai/state/`)가 아니라 그 안의 파일(`/*`)을 제외해야 아래 ! 예외가 살아남는다
# — git 은 부모 디렉터리가 제외되면 안쪽 파일을 되살릴 수 없다.
**/.moai/state/*
!.moai/state/.gitkeep
!.moai/state/session-memo.md
.moai/harness/
.moai/lessons-inbox.jsonl

# settings.local.json 은 위(Claude Code 구간)에서 이미 무시된다. 동반 생성되는 잠금 파일도 함께.
.claude/settings.local.json.lock
