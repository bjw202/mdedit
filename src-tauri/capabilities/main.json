{
  "$schema": "../node_modules/@tauri-apps/cli/schema/acl/schemas/capability.schema.json",
  "identifier": "main-capability",
  "description": "Capability for the main window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "allow-read-file",
    "allow-write-file",
    "allow-read-file-size",
    "allow-create-file",
    "allow-delete-file",
    "allow-rename-file",
    "allow-save-file-as",
    "allow-export-save-dialog",
    "allow-write-binary-file",
    "allow-print-current-window",
    "allow-read-directory",
    "allow-open-directory-dialog",
    "allow-register-asset-scope",
    "allow-start-watch",
    "allow-stop-watch",
    "allow-save-image-from-clipboard",
    "allow-copy-image-to-folder",
    "allow-read-image-as-base64",
    "allow-read-relative-image-as-base64",
    "allow-open-image-dialog",
    "allow-open-url-in-browser",
    "allow-ai-request",
    "allow-ai-cancel",
    "allow-ai-detect-providers",
    "allow-ai-policy-status",
    "allow-take-pending-open-file",
    "opener:default",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "**" }]
    },
    {
      "identifier": "opener:allow-reveal-item-in-dir",
      "allow": [{ "path": "**" }]
    }
  ]
}
